{
  "manifest_version": 3,
  "name": "Upwork Job Quality Grader",
  "version": "1.0.6",
  "description": "Evalúa trabajos de Upwork en tiempo real con scoring inteligente.",
  "host_permissions": [
    "https://www.upwork.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/nx/*",
        "https://www.upwork.com/freelancers/*"
      ],
      "js": [
        "sniper-core-shared.js",
        "sniper-core-preflight.js",
        "sniper-core-evaluate.js",
        "sniper-core.js",
        "extractors-names.js",
        "extractors.js",
        "content-script-base.js",
        "content-script-methods-i18n.js",
        "content-script-methods-route-detection.js",
        "content-script-methods-skills-core.js",
        "content-script-methods-skills-niche.js",
        "content-script-methods-skills-storage.js",
        "content-script-methods-skills-sidebar.js",
        "content-script-methods-skills-match.js",
        "content-script-methods-overlay-cards.js",
        "content-script-methods-overlay-cleanup.js",
        "content-script-methods-overlay-render.js",
        "content-script-methods-overlay-settings.js",
        "content-script-methods-overlay-settings-weights.js",
        "content-script-methods-overlay-settings-events.js",
        "content-script-methods-overlay-refresh.js",
        "content-script-methods-flow-overlay.js",
        "content-script-methods-flow-route.js",
        "content-script-methods-cache-storage.js",
        "content-script-methods-cache.js",
        "content-script-badge-definitions.js",
        "content-script-methods-ui-badges.js",
        "content-script-methods-ui-score.js",
        "content-script.js"
      ],
      "css": [
        "styles-base.css",
        "styles-settings.css",
        "styles-settings-weights.css",
        "styles-missing-skills.css",
        "styles-overlay-a.css",
        "styles-overlay-b.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
