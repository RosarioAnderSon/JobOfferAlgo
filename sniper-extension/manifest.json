{
  "manifest_version": 3,
  "name": "Upwork Job Quality Grader",
  "version": "1.0.3",
  "description": "Evalúa trabajos de Upwork en tiempo real con scoring inteligente.",
  "host_permissions": [
    "https://www.upwork.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/nx/*"
      ],
      "js": [
        "sniper-core.js",
        "extractors.js",
        "content-script.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
